{"publish":{"publish_pages_app":true,"publish_static_site":false,"publish_sha":"","publish_iso_date":"","include_slug_in_base":true},"users":[{"login_name":"BiancaR132","avatar_url":"https://avatars.githubusercontent.com/u/320781996?v=4","admin":true},{"login_name":"ZoeGes","avatar_url":"https://avatars.githubusercontent.com/u/320423987?v=4","admin":false,"not_accepted":true},{"login_name":"RyFlo21","avatar_url":"https://avatars.githubusercontent.com/u/320564835?v=4","admin":false,"not_accepted":true},{"login_name":"sanjeon04","avatar_url":"https://avatars.githubusercontent.com/u/342269588?v=4","admin":false,"not_accepted":true}],"project":{"github_org":"BiancaR132","is_private":false,"title":"Cognitive Effects of Social Media ","description":"This AVAnnotate project examines the relationship between social media use and cognitive functioning, exploring how prolonged exposure, social disconnection, and the presentation of idealised or distorted realities may influence psychological and cognitive processes. The project investigates five key areas: addiction, stress and anxiety, memory, concentration, and sleep. It considers how algorithmic design and reward-based mechanisms may reinforce habitual use by activating the brain’s dopamine-mediated reward pathways, potentially contributing to problematic patterns of engagement. Through a series of individual videos, the project explores the cognitive and psychological implications associated with social media use, critically examining its potential effects on everyday functioning and overall well-being. Each video focuses on a distinct issue and presents evidence-informed strategies to mitigate these effects, promoting greater awareness of digital habits and encouraging healthier, more intentional engagement with social media.","language":"en","slug":"Social-Media-Cognition","creator":"BiancaR132","authors":"Bianca Rammesmayer, Zoe Gesmundo, Kate Hooton, San Jeon, Ryan Florence","media_player":"avannotate","auto_populate_